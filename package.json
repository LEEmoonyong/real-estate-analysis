{
  "name": "sunlight-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "전국 단위 3D 아파트 단지 일조량 시뮬레이터 (React 과제)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "cross-env TZ=America/New_York vitest run",
    "coverage": "vitest run --coverage",
    "verify:api": "tsx scripts/verify-api.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "3.10.1",
    "three": "0.173.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/suncalc": "1.9.2",
    "@types/three": "0.173.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "suncalc": "2.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
