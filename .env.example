# 이 파일을 .env.local 로 복사해 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# 키가 없어도 앱은 샘플 모드로 동작합니다.

# --- 서버(프록시) 전용: VITE_ 접두사를 붙이지 마세요 (클라이언트 번들 노출 방지) ---
# 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# V-World 오픈API 인증키
VWORLD_API_KEY=
# V-World 인증키 발급 시 등록한 서비스 URL (로컬 개발 시 등록한 URL과 정확히 일치해야 함)
VWORLD_DOMAIN=http://localhost:5173

# --- 클라이언트 플래그 (비밀 아님) ---
VITE_FORCE_SAMPLE_MODE=false
# 로컬에 키가 없을 때 빌려 쓰는 배포 서버 (기본값: https://sunlight-simulator-alpha.vercel.app). 빈 값이면 사용 안 함
# VITE_REMOTE_API_BASE=

# --- 확장 기능 (부동산 탐색) ---
# 카카오 JavaScript 키 — 지도 표시. 공개 키(카카오 콘솔에 등록한 도메인에서만 동작)
VITE_KAKAO_JS_KEY=
# 공공데이터포털 일반 인증키(Decoding) — 실거래가·단지 정보·건축물대장 (서버 전용)
DATA_GO_KR_SERVICE_KEY=
# 금감원 금융상품한눈에 오픈API 인증키 — 주택담보대출 금리 (서버 전용)
FSS_FINLIFE_API_KEY=
